@startuml use-case-diagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Student
actor Warden
actor "Security Guard" as Security
actor Admin

rectangle "Hostel Management System" {
  usecase "Register Account" as UC1
  usecase "Login" as UC2
  usecase "View Allocation & Dues" as UC3
  usecase "Submit Complaint" as UC4
  usecase "Manage Complaint" as UC5
  usecase "Request Leave / Outpass" as UC6
  usecase "Approve / Reject Leave" as UC7
  usecase "Log Visitor Entry/Exit" as UC8
  usecase "Allocate Room" as UC9
  usecase "Record Fee Payment" as UC10
  usecase "Post Notice" as UC11
  usecase "Generate Occupancy Report" as UC12
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC6

Warden --> UC2
Warden --> UC5
Warden --> UC7

Security --> UC2
Security --> UC8

Admin --> UC2
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12

UC4 ..> UC2 : <<include>>
UC6 ..> UC2 : <<include>>
UC9 ..> UC2 : <<include>>
UC10 ..> UC2 : <<include>>
@enduml
