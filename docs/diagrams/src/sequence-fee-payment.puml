@startuml sequence-fee-payment
title Manual fee payment recording
participant "Admin / browser" as P0
participant "fees.views / form" as P1
participant "record_payment service" as P2
database "SQLite" as P3
P0 -> P1 : POST /fees/payments/new/
P1 -> P1 : Enforce Admin role; validate form
P1 -> P2 : record_payment(account, amount, mode, reference)
P2 -> P3 : Atomic: read fee account
P2 -> P2 : Validate amount / due; ONLINE requires reference
P2 -> P3 : Create payment and unique receipt; update paid; audit
P2 --> P1 : Success: payment returned after transaction
P1 --> P0 : 302 /fees/receipts/{id}/
P2 --> P1 : Invalid: PaymentError (transaction rolled back)
P1 --> P0 : Error: render payment form
@enduml
