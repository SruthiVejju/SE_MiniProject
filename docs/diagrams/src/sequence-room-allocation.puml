@startuml sequence-room-allocation
title Room allocation
participant "Admin / browser" as P0
participant "hostel.views / form" as P1
participant "allocate_bed service" as P2
database "SQLite" as P3
P0 -> P1 : POST /hostel/allocate/
P1 -> P1 : Enforce Admin role; validate form
P1 -> P2 : allocate_bed(student, bed_id, admin_user)
P2 -> P3 : Atomic: read bed / active allocations
P3 --> P2 : Current availability
P2 -> P3 : Available: create allocation; mark occupied; audit
P2 --> P1 : Success: allocation returned after transaction
P1 --> P0 : 302 allocation confirmation redirect
P2 --> P1 : Occupied / conflict / DB busy: AllocationError
P1 --> P0 : Error: render form with validation message
@enduml
